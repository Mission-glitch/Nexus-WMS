{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Web Server (Python Port 3300)",
            "type": "shell",
            "command": "python -m http.server 3300 --directory public",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*Serving HTTP on.*",
                    "endsPattern": ".*Serving HTTP on.*"
                }
            }
        },
        {
            "label": "Run start.bat",
            "type": "shell",
            "command": "${workspaceFolder}/start.bat",
            "problemMatcher": []
        }
    ]
}
